generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  avatar        String?
  passwordHash  String
  role          String    @default("Viewer")
  teams         String    @default("")
  applications  String    @default("")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  preferences   String    @default("{}")
  permissions   String    @default("{}")
  
  sessions      Session[]
  auditLogs     AuditLog[]
  assignedTickets Ticket[] @relation("AssignedTickets")
  reportedTickets Ticket[] @relation("ReportedTickets")
  comments      TicketComment[]
  remediationNotes RemediationNote[]
  actionItems   ActionItem[] @relation("ActionItemAssignee")
  actionItemsCreated ActionItem[] @relation("ActionItemCreator")
  
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  device       String?
  location     String?
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  userEmail   String
  action      String
  resource    String
  resourceId  String?
  details     String   @default("{}")
  ipAddress   String?
  userAgent   String?
  status      String   @default("success")
  errorMessage String?
  duration    Int?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Ticket {
  id                  String        @id @default(uuid())
  key                 String        @unique
  summary             String
  description         String
  priority            String
  severity            String
  status              String        @default("Open")
  requestType         String
  application         String
  reporterId          String
  reporterName        String
  reporterEmail       String
  assigneeId          String?
  assigneeName        String?
  assigneeEmail       String?
  team                String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  resolvedAt          DateTime?
  closedAt            DateTime?
  dueDate             DateTime?
  firstResponseAt     DateTime?
  tags                String        @default("")
  customFields        String        @default("{}")
  customerSatisfaction Int?
  timeToFirstResponse Int?
  timeToResolution    Int?
  businessImpact      String?
  rootCause           String?
  category            String?
  subCategory         String?
  
  reporter            User          @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee            User?         @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments            TicketComment[]
  attachments         Attachment[]
  reopenHistory       ReopenHistory[]
  remediationNotes    RemediationNote[]
  linkedIssues        LinkedIssue[]
  aiInsights          AIInsight[]
  aiAnalysis          AIAnalysis?
  sla                 SLAInfo?
  
  @@index([application])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([key])
  @@map("tickets")
}

model TicketComment {
  id              String       @id @default(uuid())
  ticketId        String
  authorId        String
  authorName      String
  authorRole      String
  content         String
  isInternal      Boolean      @default(false)
  isAI            Boolean      @default(false)
  aiInsightType   String?
  aiConfidence    Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  ticket          Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  
  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_comments")
}

model Attachment {
  id          String         @id @default(uuid())
  ticketId    String
  fileName    String
  fileSize    Int
  mimeType    String
  type        String
  url         String
  uploadedBy  String
  uploadedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@map("attachments")
}

model SLAInfo {
  id                    String     @id @default(uuid())
  ticketId              String     @unique
  slaName               String
  targetResponseTime    Int
  targetResolutionTime  Int
  actualResponseTime    Int?
  actualResolutionTime  Int?
  status                String     @default("Met")
  breachedAt            DateTime?
  pausedAt              DateTime?
  resumedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  
  ticket                Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@map("sla_info")
}

model ReopenHistory {
  id                String        @id @default(uuid())
  ticketId          String
  reopenedBy        String
  reopenedByRole    String
  reason            String
  previousStatus    String
  reopenedAt        DateTime      @default(now())
  resolutionNotes   String?
  createdAt         DateTime      @default(now())
  
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@map("reopen_history")
}

model RemediationNote {
  id              String       @id @default(uuid())
  ticketId        String
  authorId        String
  authorName      String
  content         String
  isComplete      Boolean      @default(false)
  isAIEnhanced    Boolean      @default(false)
  aiConfidence    Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  ticket          Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author          User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  
  @@index([ticketId])
  @@index([authorId])
  @@map("remediation_notes")
}

model LinkedIssue {
  id                   String           @id @default(uuid())
  ticketId             String
  linkedIssueKey       String
  linkedIssueSummary   String
  linkType             String
  createdAt            DateTime         @default(now())
  
  ticket               Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@index([linkedIssueKey])
  @@map("linked_issues")
}

model AIInsight {
  id            String          @id @default(uuid())
  ticketId      String
  type          String
  title         String
  description   String
  confidence    Float
  generatedBy   String
  generatedAt   DateTime        @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  isActionable  Boolean         @default(true)
  tags          String          @default("")
  metadata      String          @default("{}")
  
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
  @@index([type])
  @@map("ai_insights")
}

model AIAnalysis {
  id                          String   @id @default(uuid())
  ticketId                    String   @unique
  executiveSummary            String
  condensedTechnicalSummary   String
  rootCause                   String
  affectedApplication         String
  remediationSummary          String
  businessImpact              String
  recommendedPreventativeActions String  @default("")
  actionItems                 String   @default("[]")
  confidenceScore             Float
  tags                        String   @default("")
  recurringIssueDetected      Boolean  @default(false)
  recurringIssueId            String?
  similarTickets              String   @default("")
  generatedBy                 String
  model                       String
  generatedAt                 DateTime @default(now())
  acknowledgedAt              DateTime?
  acknowledgedBy              String?
  
  ticket                      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@map("ai_analyses")
}

model Engineer {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  avatar        String?
  role          String
  team          String
  applications  String   @default("")
  expertise     String   @default("")
  isActive      Boolean  @default(true)
  hireDate      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  preferences   String   @default("{}")
  
  performance   EngineerPerformance[]
  workload      EngineerWorkload?
  
  @@map("engineers")
}

model EngineerPerformance {
  id                       String   @id @default(uuid())
  engineerId               String
  engineerName             String
  team                     String
  periodStart              DateTime
  periodEnd                DateTime
  ticketsAssigned          Int      @default(0)
  ticketsResolved          Int      @default(0)
  ticketsReopened          Int      @default(0)
  avgResolutionTime        Float    @default(0)
  medianResolutionTime     Float    @default(0)
  slaComplianceRate        Float    @default(0)
  slaMet                   Int      @default(0)
  slaBreached              Int      @default(0)
  slaAtRisk                Int      @default(0)
  avgPriority              Float    @default(0)
  applicationsSupported    String   @default("")
  customerSatisfaction     Float    @default(0)
  qualityScore             Float    @default(0)
  utilizationRate          Float    @default(0)
  workloadTrend            String   @default("stable")
  recurringTicketTypes     String   @default("")
  aiSummary                String
  previousPeriodComparison String   @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  engineer                 Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  
  @@unique([engineerId, periodStart, periodEnd])
  @@index([engineerId])
  @@index([periodStart, periodEnd])
  @@map("engineer_performance")
}

model EngineerWorkload {
  id                   String   @id @default(uuid())
  engineerId           String   @unique
  engineerName         String
  team                 String
  currentTickets       Int      @default(0)
  openTickets          Int      @default(0)
  inProgressTickets    Int      @default(0)
  overdueTickets       Int      @default(0)
  dueTodayTickets      Int      @default(0)
  avgResolutionTime    Float    @default(0)
  capacity             Float    @default(0)
  recommendedAction    String?
  updatedAt            DateTime @updatedAt
  
  engineer             Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  
  @@map("engineer_workload")
}

model Application {
  id                  String   @id @default(uuid())
  name                String   @unique
  displayName         String
  description         String
  owner               String
  ownerEmail          String
  team                String
  criticality         String
  type                String
  environment         String   @default("Production")
  technologies        String   @default("")
  dependencies        String   @default("")
  slaResponseTime     Int
  slaResolutionTime   Int
  healthHealthy       Int      @default(80)
  healthDegraded      Int      @default(50)
  healthCritical      Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  healthScores        ApplicationHealthScore[]
  healthReports       ApplicationHealth[]
  
  @@map("applications")
}

model ApplicationHealthScore {
  id                  String   @id @default(uuid())
  applicationId       String
  applicationName     String
  date                DateTime
  healthScore         Int
  ticketVolume        Int
  avgSeverity         Float
  slaViolations       Int
  resolutionTime      Float
  repeatIncidents     Int
  reopenedTickets     Int
  criticalIncidents   Int
  ticketVolumeWeight  Float    @default(0.15)
  avgSeverityWeight   Float    @default(0.15)
  slaViolationsWeight Float    @default(0.20)
  resolutionTimeWeight Float   @default(0.15)
  repeatIncidentsWeight Float  @default(0.15)
  reopenedTicketsWeight Float  @default(0.10)
  criticalIncidentsWeight Float @default(0.10)
  riskLevel           String
  trend               String
  recommendedActions  String   @default("")
  calculatedAt        DateTime @default(now())
  
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, date])
  @@index([applicationId])
  @@index([date])
  @@map("application_health_scores")
}

model ApplicationHealth {
  id                      String   @id @default(uuid())
  applicationId           String
  applicationName         String
  periodStart             DateTime
  periodEnd               DateTime
  healthScore             Int
  status                  String
  trend                   String
  ticketVolume            Int
  ticketTrend             Float
  avgSeverity             Float
  slaComplianceRate       Float
  avgResolutionTime       Float
  medianResolutionTime    Float
  reopenRate              Float
  customerSatisfaction    Float
  criticalIncidents       Int
  recurringIncidents      Int
  topRootCauses           String   @default("")
  priorityDistribution    String   @default("{}")
  requestTypeDistribution String   @default("{}")
  monthlyTrend            String   @default("[]")
  aiOperationalNarrative  String
  topRecommendations      String   @default("")
  riskFactors             String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  application             Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@unique([applicationId, periodStart, periodEnd])
  @@index([applicationId])
  @@map("application_health")
}

model MonthlyReport {
  id                  String      @id @default(uuid())
  name                String
  periodStart         DateTime
  periodEnd           DateTime
  status              String      @default("draft")
  generatedBy         String
  generatedAt         DateTime    @default(now())
  reviewedBy          String?
  reviewedAt          DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  executiveSummary    String
  kpis                String      @default("[]")
  charts              String      @default("[]")
  operationalRisks    String      @default("[]")
  recurringIssues     String      @default("[]")
  engineerHighlights  String      @default("[]")
  applicationHealth   String      @default("[]")
  recommendations     String      @default("[]")
  actionItems         String      @default("[]")
  appendix            String      @default("{}")
  metadata            String      @default("{}")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("monthly_reports")
}

model RecurringIssue {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  pattern               String
  frequency             Int
  affectedApplications  String   @default("")
  affectedTickets       String   @default("")
  rootCause             String
  currentWorkaround     String
  permanentFix          String
  fixStatus             String   @default("not_started")
  fixOwner              String
  fixTargetDate         DateTime
  businessImpact        String
  slaImpact             Float
  costEstimate          Float
  aiConfidence          Float
  identifiedAt          DateTime @default(now())
  lastOccurrence        DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([fixStatus])
  @@index([businessImpact])
  @@map("recurring_issues")
}

model OperationalRisk {
  id                  String       @id @default(uuid())
  title               String
  description         String
  likelihood          String
  impact              String
  riskScore           Int
  category            String
  affectedApplications String     @default("")
  affectedTeams       String       @default("")
  mitigation          String
  owner               String
  status              String       @default("open")
  identifiedAt        DateTime     @default(now())
  lastReviewedAt      DateTime
  nextReviewAt        DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  @@index([status])
  @@index([riskScore])
  @@map("operational_risks")
}

model ActionItem {
  id              String       @id @default(uuid())
  title           String
  description     String
  assignee        String
  assigneeEmail   String
  dueDate         DateTime
  priority        String
  status          String       @default("pending")
  dependencies    String       @default("")
  tags            String       @default("")
  assigneeUserId  String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  assigneeUser    User?        @relation("ActionItemAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("ActionItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  @@index([assigneeUserId])
  @@index([status])
  @@index([dueDate])
  @@map("action_items")
}

model ProviderConfig {
  id              String   @id @default(uuid())
  name            String
  type            String
  isEnabled       Boolean  @default(true)
  isDefault       Boolean  @default(false)
  config          String   @default("{}")
  credentials     String?
  syncSchedule    String?
  filters         String?
  fieldMappings   String   @default("{}")
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([name])
  @@map("provider_configs")
}

model AIProviderConfig {
  id              String   @id @default(uuid())
  name            String
  type            String
  isEnabled       Boolean  @default(true)
  isDefault       Boolean  @default(false)
  config          String   @default("{}")
  credentials     String?
  prompts         String   @default("{}")
  rateLimits      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([name])
  @@map("ai_provider_configs")
}

model Settings {
  id          String   @id @default("singleton")
  general     String   @default("{}")
  dashboard   String   @default("{}")
  tickets     String   @default("{}")
  ai          String   @default("{}")
  reports     String   @default("{}")
  security    String   @default("{}")
  integrations String  @default("{}")
  notifications String @default("{}")
  updatedAt   DateTime @updatedAt
  updatedBy   String
  
  @@map("settings")
}

model TrendHistory {
  id              String   @id @default(uuid())
  metric          String
  dimension       String
  dimensionValue  String
  periodStart     DateTime
  periodEnd       DateTime
  value           Float
  previousValue   Float?
  changePercent   Float?
  trend           String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  
  @@unique([metric, dimension, dimensionValue, periodStart, periodEnd])
  @@index([metric])
  @@index([dimension, dimensionValue])
  @@index([periodStart, periodEnd])
  @@map("trend_history")
}
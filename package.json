{
  "name": "jira-executive-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently \"npm run dev --workspace=packages/backend\" \"npm run dev --workspace=packages/frontend\"",
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "db:generate": "prisma generate --workspace=packages/backend",
    "db:push": "prisma db push --workspace=packages/backend",
    "db:studio": "prisma studio --workspace=packages/backend",
    "db:seed": "tsx packages/backend/prisma/seed.ts",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "start": "node packages/backend/dist/index.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}